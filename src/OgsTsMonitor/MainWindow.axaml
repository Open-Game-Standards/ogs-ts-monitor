<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OgsTsMonitor"
        xmlns:m="using:Ogs.Telemetry.Monitor"
        x:Class="OgsTsMonitor.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="OGS-TS Monitor"
        Icon="/Assets/telemetry-standard.png"
        Width="1360" Height="900" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock.status.error">
      <Setter Property="Foreground" Value="#f0956c"/>
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="Opacity" Value="0.75"/>
    </Style>
  </Window.Styles>
  <DockPanel Margin="14">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="{StaticResource TelemetryStandardLogo}" Width="56" Height="56" Margin="-4,-6,0,-6"/>
        <StackPanel>
          <TextBlock Text="OGS-TS Monitor" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="Open Game Standards · Telemetry Standard receiver" FontSize="11" Opacity="0.7"/>
        </StackPanel>
      </StackPanel>

      <WrapPanel Grid.Column="1" Orientation="Horizontal" Margin="28,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
        <WrapPanel.Styles>
          <Style Selector="WrapPanel &gt; :is(Control)"><Setter Property="Margin" Value="0,2,8,2"/></Style>
        </WrapPanel.Styles>
        <TextBlock Text="Group" VerticalAlignment="Center" Opacity="0.75"/>
        <TextBox Text="{Binding Group}" Width="130" IsEnabled="{Binding CanEditEndpoint}"/>
        <TextBlock Text="Port" VerticalAlignment="Center" Opacity="0.75"/>
        <TextBox Text="{Binding Port}" Width="72" IsEnabled="{Binding CanEditEndpoint}"/>
        <TextBlock Text="Interface" VerticalAlignment="Center" Opacity="0.75"/>
        <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}"
                  Width="220" IsEnabled="{Binding CanEditEndpoint}"/>
        <Button Content="{Binding ListenLabel}" Click="OnListen" Classes="accent" MinWidth="72"
                HorizontalContentAlignment="Center"/>
        <Button Content="{Binding RecordGlyph}" Click="OnRecord" MinWidth="34" HorizontalContentAlignment="Center">
          <ToolTip.Tip>
            <StackPanel MaxWidth="320">
              <TextBlock Text="{Binding RecordLabel}" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Text="Record everything this monitor receives to an .ogsrec file, to replay into rigs and tools later."/>
            </StackPanel>
          </ToolTip.Tip>
        </Button>
        <Button Content="{Binding PlayGlyph}" Click="OnPlay" MinWidth="34" HorizontalContentAlignment="Center">
          <ToolTip.Tip>
            <StackPanel MaxWidth="320">
              <TextBlock Text="{Binding PlayLabel}" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Text="Play an .ogsrec recording in this monitor at its original pace. Nothing is sent on the network."/>
            </StackPanel>
          </ToolTip.Tip>
        </Button>
        <Button Content="✕" Click="OnClear" MinWidth="34" HorizontalContentAlignment="Center"
                ToolTip.Tip="Clear everything the monitor has collected"/>
        <Button Content="{Binding DemoText}" Click="OnDemo">
          <ToolTip.Tip>
            <StackPanel MaxWidth="340">
              <TextBlock Text="{Binding DemoLabel}" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Text="Publish a demo car to this monitor only (loopback, its own port), so you can see it work without a game. Nothing else on this machine or your network receives it. Start with --demo-lan to send it on your network instead."/>
            </StackPanel>
          </ToolTip.Tip>
        </Button>
      </WrapPanel>
    </Grid>

    <Border DockPanel.Dock="Bottom" BorderBrush="#33808080" BorderThickness="0,1,0,0" Padding="2,6,2,0" Margin="0,8,0,0">
      <TextBlock Text="{Binding Status}" Classes="status" Classes.error="{Binding StatusIsError}"
                 FontSize="12" TextTrimming="CharacterEllipsis"/>
    </Border>

    <m:MonitorView DataContext="{Binding Monitor}"/>
  </DockPanel>
</Window>
